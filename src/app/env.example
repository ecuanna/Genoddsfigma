# ─── The Odds API ────────────────────────────────────────────────
# https://the-odds-api.com — Get your API key from the dashboard.
# Free tier: 500 requests/month. Pays per sport fetch.
#
# When set, the app fetches real-time odds instead of demo data.
VITE_ODDS_API_KEY=

# Polling intervals in milliseconds
VITE_POLL_INTERVAL_LIVE=30000      # 30s when live events exist
VITE_POLL_INTERVAL=120000           # 2min for upcoming events

# ─── EmailJS (OTP Email Delivery) ─────────────────────────────────
# https://emailjs.com — Free tier: 200 emails/month, no backend.
#
# Setup:
#   1. Create account at emailjs.com
#   2. Connect your email service (Gmail, Outlook, SendGrid, etc.)
#   3. Create a template with variables:
#        {{to_email}}   — recipient address
#        {{otp_code}}   — the 6-digit verification code
#        {{expires_in}} — e.g. "5 minutes"
#   4. Copy the IDs below
#
# When NOT configured, the app runs in demo mode:
#   the OTP code is displayed on-screen for testing.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
