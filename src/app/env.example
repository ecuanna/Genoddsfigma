# ─── GENODDS API Configuration ─────────────────────────────────
# Copy this file to .env and fill in your values.
# If VITE_ODDS_API_URL is empty, the app will use mock data.

# Base URL for the odds API (e.g. https://api.genodds.com/v1)
VITE_ODDS_API_URL=

# API key for authentication
VITE_ODDS_API_KEY=

# Polling intervals in milliseconds
# Default: 30000 (30s) for live events, 120000 (2min) for upcoming
VITE_POLL_INTERVAL_LIVE=30000
VITE_POLL_INTERVAL=120000
